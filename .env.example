# IMPORTANTE: Nunca insira chaves secretas como service_role no frontend.
# Utilize apenas a chave anônima/pública (publishable anon key).

# Supabase Backend (PostgreSQL + Auth)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-publishable-key

# Cloudflare Turnstile Bot Protection (Opcional)
TURNSTILE_SITE_KEY=0x4AAAAAAAYourSiteKeyHere
