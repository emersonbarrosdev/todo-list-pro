{
  "name": "todo-list",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "node --require ./scripts/node-version-shim.cjs ./node_modules/@angular/cli/bin/ng.js",
    "start": "node --require ./scripts/node-version-shim.cjs ./node_modules/@angular/cli/bin/ng.js serve",
    "build": "node --require ./scripts/node-version-shim.cjs ./node_modules/@angular/cli/bin/ng.js build",
    "watch": "node --require ./scripts/node-version-shim.cjs ./node_modules/@angular/cli/bin/ng.js build --watch --configuration development",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@supabase/supabase-js": "^2.118.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@playwright/test": "^1.64.1",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
